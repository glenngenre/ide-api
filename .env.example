# Server
ADDR=:8080

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_HOURS=24

# First admin user (created on first boot if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# SQLite database path (inside container, mount a volume here)
DB_PATH=/app/data/ide.db

# Ollama — use Docker service name when on the same network
OLLAMA_BASE_URL=http://ollama:11434

# Judge0
JUDGE0_BASE_URL=https://judge0.apps.skwtr.com
JUDGE0_AUTHN_TOKEN=replace_with_your_token

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://ide.apps.skwtr.com
